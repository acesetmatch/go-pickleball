{
  "name": "paddle-recommender-typescript",
  "version": "1.0.0",
  "description": "TypeScript + Fastify paddle recommendation service",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset",
    "scrape:mattspickleball:csv": "tsx scripts/scraper/parseMattspickleballCSV.ts",
    "scrape:pickleballeffect:csv": "tsx scripts/scraper/parsePickleballEffectCSV.ts",
    "scrape:pickleballeffect:download": "tsx scripts/scraper/downloadPickleballEffectCsv.ts",
    "scrape:pickleballstudio:csv": "tsx scripts/scraper/parsePickleballStudioCSV.ts",
    "harmonize": "tsx scripts/scraper/harmonizeData.ts",
    "combine:median": "tsx scripts/scraper/combineSourcesMedian.ts",
    "scrape:all": "bash scripts/scraper/scrapeAll.sh",
    "import:harmonized": "tsx scripts/importHarmonizedData.ts",
    "import:harmonized:clear": "tsx scripts/importHarmonizedData.ts --clear",
    "import:pickleballeffect:from-csv": "npm run scrape:pickleballeffect:csv && npm run harmonize -- --source pickleballeffect && npm run import:harmonized -- --source pickleballeffect",
    "db:update-normalized": "tsx scripts/updateNormalizedCompanies.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/env": "^5.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.1",
    "@prisma/client": "^6.16.3",
    "@types/pg": "^8.15.5",
    "airtable": "^0.12.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.7.2",
    "pg": "^8.16.3",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^6.16.3"
  },
  "overrides": {
    "fast-jwt": "^6.2.4",
    "fast-uri": "^3.1.2",
    "defu": "^6.1.5",
    "effect": "^3.20.0",
    "lodash": "^4.18.0",
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "playwright-core": "^1.57.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "paddle",
    "recommendation",
    "pickleball",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/tests/**",
      "!src/server.ts"
    ]
  }
}
