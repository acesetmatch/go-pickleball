# Docker-specific environment variables
# Copy this to .env for local development: cp .env.docker .env

# Application
APP_NAME=paddle-recommendation-service
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_TITLE="Paddle Recommendation API"
API_DESCRIPTION="AI-powered pickleball paddle recommendations"
CORS_ORIGINS=["http://localhost:3000","https://yourapp.com"]

# Database (Docker service names)
DATABASE_URL=postgresql://paddle_user:paddle_pass@postgres:5432/paddle_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Vector Store (ChromaDB)
CHROMA_PERSIST_DIR=/app/chroma_db
CHROMA_COLLECTION_NAME=paddle_specs_v2
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Redis Cache (Docker service name)
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
CACHE_TTL=3600

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# LLM Configuration (if using OpenAI)
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# Monitoring
PROMETHEUS_PORT=9090
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Security
SECRET_KEY=change-this-to-a-secure-random-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
